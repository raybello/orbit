# Env file for the source-based stack (infra/compose/docker-compose.yml).
#
#   cp infra/compose/.env.example ../../.env     # what the stack actually loads
#   docker compose -f infra/compose/docker-compose.yml up --build
#
# Two jobs, which is why the paths differ:
#   * values marked (interpolation) are read by `docker compose` itself;
#   * every other value is passed into the containers from ../../.env, so keep the copy there.
# Empty means "the server's own default".

# ---- compose-level (interpolation) ----
# Port on 127.0.0.1 that serves the API *and* the web client.
ORBIT_WEB_PORT=8787
# Optional absolute host folder for per-bot Docker computers. A bot container's home is a host
# bind mount, so this path must exist identically inside the api container — see the comment in
# docker-compose.yml before using it.
# ORBIT_HOST_DATA=/home/you/.orbit/data
# COMPUTER_HOME_DIR=/home/you/.orbit/data/computers
LOG_LEVEL=info

# ---- the app ----
# Required. The server exits without it (it also signs the agents' MCP tokens).
# Generate one: openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://127.0.0.1:8787
SERVER_URL=http://127.0.0.1:8787
# 0 by default: with 1 and an empty ALLOWED_EMAILS, anyone who reaches the port can mint a session
# for any email. Turn it on deliberately, on a machine only you can reach.
DEV_LOGIN=0
# Comma-separated emails allowed to sign in; empty = anyone who can reach the app (with DEV_LOGIN=0
# that means owner-key or Google sign-in only).
ALLOWED_EMAILS=

# ---- the agents (Hermes) ----
# Managed bots run `hermes gateway run` inside the api container, so the CLI has to be the one the
# image installs. Leave it empty (or a host path) and the server still finds the image's Hermes: it
# resolves HERMES_BIN, then PATH, then the known install locations.
HERMES_BIN=
# The primary agent's own gateway can stay on the host (it is somebody's live desktop); Docker
# Desktop publishes it as host.docker.internal. A managed bot's engine is started in here.
HERMES_URL=http://host.docker.internal:8642
# The host's Hermes home (its .env, config.yaml, auth.json), bind-mounted into the api container at
# /host-hermes (HERMES_HOME_PRIMARY there). A managed bot copies its credentials and model choice
# from it, so without it every new agent starts with no API key.
HERMES_HOME_HOST=
HERMES_KEY=
MCP_BASE_URL=http://host.docker.internal:8787
PRIMARY_BOT_NAME=
PRIMARY_BOT_LABEL=
# JSON object of extra mcp_servers entries every managed bot gets.
EXTRA_MCP_SERVERS=

# ---- the shared computer (Orgo) ----
ORGO_API_KEY=
ORGO_COMPUTER_ID=
HQ_LOCAL=0
MAX_BOTS=4

# ---- a container of its own per bot ----
# orgo | docker | auto. In this stack 'auto' wants a working Docker socket and the host-path
# caveat above; 'orgo' needs no Docker at all.
COMPUTER_KIND=auto
# Leave unqualified to build apps/server/docker/computer on first use, or set a published tag,
# e.g. ghcr.io/raybello/orbit/computer:edge
COMPUTER_IMAGE=
COMPUTER_IDLE_TIMEOUT_MIN=30
COMPUTER_CPU_LIMIT=2
COMPUTER_MEMORY_LIMIT=2g
COMPUTER_NETWORK=bridge

# ---- connectors, X research, voice ----
# Optional at boot: both clients are built lazily on first use, so the server starts with these
# empty and simply leaves the connector apps, X research or voice unavailable until a real key is
# set. An empty value is not an error.
COMPOSIO_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.7

# ---- Google OAuth2 (Gmail + Calendar) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- stack secret (desktop app only; the desktop writes these itself) ----
STACK_TOKEN=
# Generated, not chosen: the desktop app mints this on first run (openssl rand -hex 32) and the
# stack refuses to start without it. Left empty here on purpose.
SANDBOX_SUPERVISOR_TOKEN=
# Not read by the server today; reserved for encrypted columns in SQLite (desktop writes it).
DB_ENCRYPTION_KEY=
