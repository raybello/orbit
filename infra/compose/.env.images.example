# Env file for the image-based stack (infra/compose/docker-compose.images.yml) — the file the
# desktop app bundles. The app's stack controller writes .env into its stack folder and fills in
# the three generated secrets below; copy this file to .env only to run the stack by hand:
#
#   cp .env.images.example .env
#   docker compose -f docker-compose.images.yml --env-file .env up -d
#   open http://127.0.0.1:8787
#
# Generated by the desktop app on first run (leave empty here; the server will not start without
# SESSION_SECRET):
#   SESSION_SECRET        signs sessions and the agents' MCP tokens — required
#   DB_ENCRYPTION_KEY     for encrypted columns in SQLite
#   STACK_TOKEN           writes into .env and sends as x-orbit-stack-token, so GET /api/health
#                         can report stackToken: 'verified' — one stack per machine

# ---- which build to run ----
# edge = main, v<version> = a release. Empty means edge.
ORBIT_IMAGE_TAG=
# Loopback port the app loads. Set 0 to let the controller pick a free port and report it.
ORBIT_WEB_PORT=8787
# Reserved for the controller; the API's port is the one above (the image serves API + web).
ORBIT_API_PORT=0

# ---- secrets the desktop app generates ----
SESSION_SECRET=
DB_ENCRYPTION_KEY=
STACK_TOKEN=
SANDBOX_SUPERVISOR_TOKEN=

# ---- the app ----
APP_URL=http://127.0.0.1:8787
SERVER_URL=http://127.0.0.1:8787
DEV_LOGIN=0
ALLOWED_EMAILS=

# ---- the agents (Hermes runs on the host) ----
HERMES_URL=http://host.docker.internal:8642
HERMES_HOME_PRIMARY=
HERMES_KEY=
MCP_BASE_URL=http://host.docker.internal:8787

# ---- the shared computer (Orgo) ----
ORGO_API_KEY=
ORGO_COMPUTER_ID=
HQ_LOCAL=0
MAX_BOTS=4

# ---- a container of its own per bot ----
# On a machine without a usable Docker socket, set orgo: the stack then needs no Docker-in-Docker
# state at all beyond running these two containers.
COMPUTER_KIND=auto
COMPUTER_IMAGE=
COMPUTER_IDLE_TIMEOUT_MIN=30
# Optional: a host folder mounted at the same absolute path inside the stack, for bot computers.
# ORBIT_HOST_DATA=/Users/you/Library/Application Support/Orbit/data
# COMPUTER_HOME_DIR=/Users/you/Library/Application Support/Orbit/data/computers

# ---- connectors, X research, voice ----
# Both are effectively required to boot today: the Composio and the xAI (OpenAI-compatible) clients
# validate their key in the constructor, so an empty value stops the server at start-up. Any
# placeholder boots it; only real keys make the apps and voice work. The desktop setup window is
# where real ones come from.
COMPOSIO_API_KEY=
XAI_API_KEY=
XAI_MODEL=grok-4.7

# ---- Google OAuth2 (Gmail + Calendar) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

LOG_LEVEL=info
