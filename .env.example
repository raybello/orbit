# Copy to .env and fill in. Never commit .env.

# ---- the app ----
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=change-me-to-a-long-random-string   # also signs the tokens the agents use to reach /mcp
DEV_LOGIN=1                       # 1 enables POST /api/auth/dev (local testing only)
ALLOWED_EMAILS=                   # comma-separated emails allowed to sign in; empty = anyone who can reach the app
# DB_PATH=./data/grokbot.db       # where the app keeps its SQLite database

# ---- the agents (Hermes) ----
HERMES_BIN=hermes                 # the hermes CLI; the server starts one gateway per bot, the primary included
# ENGINES_DIR=./data/engines      # every bot's Hermes home; the primary's is <ENGINES_DIR>/primary
# PRIMARY_ENGINE_PORT=8642        # the port the primary's API server asks for first (loopback)
# ENGINE_PORT_BASE=8650           # the other bots' ports start here
# HERMES_IMPORT_FROM=~/.hermes    # your own Hermes home, imported into the primary's once at first boot
# CONTEXT_COMPACTION_THRESHOLD=350000  # tokens at which a bot's Hermes summarizes older turns
# EXTRA_MCP_SERVERS=              # JSON object of Hermes mcp_servers entries every bot gets
# PRIMARY_BOT_NAME=Atlas
# PRIMARY_BOT_LABEL=Chief of Staff

# ---- the one computer every bot works on (one Orgo screen per bot) ----
ORGO_API_KEY=                     # or ORGO_API_KEY_FILE=/path/to/file
ORGO_COMPUTER_ID=
HQ_LOCAL=0                        # 1 when this server runs on that computer (production)
# PRIMARY_CDP_URL=http://127.0.0.1:9333   # a Chrome the first bot already owns on the default screen
# MAX_BOTS=10                     # default 10 (4 with COMPUTER_KIND=orgo: four screens on one Orgo computer)

# ---- a computer of its own for each bot (Docker; see docs/per-bot-computers.md) ----
COMPUTER_KIND=auto                # 'orgo' | 'docker' | 'auto' (auto: docker for every bot but the primary)
COMPUTER_IMAGE=orbit/computer:local   # built from server/docker/computer when unqualified
# COMPUTER_HOME_DIR=./data/computers   # each bot's home folder and workspace checkpoints
# COMPUTER_PAUSE_AFTER_MIN=5          # freeze an idle bot (no CPU, instant wake); 0 = never
# COMPUTER_IDLE_TIMEOUT_MIN=30        # checkpoint and stop it (gives its memory back)
# COMPUTER_CPU_LIMIT=1
# COMPUTER_MEMORY_LIMIT=900m          # hard cap per bot
# COMPUTER_MEMORY_RESERVATION=600m    # soft limit, and what a bot counts for when deciding if another fits; 0 = no check
# COMPUTER_NETWORK=bridge
# DOCKER_SOCKET=/var/run/docker.sock   # empty: DOCKER_HOST, else Docker's default
# The model every new Bot (the primary included) runs unless one is picked when it is created.
# Credentials still come from the primary agent.
# DEFAULT_BOT_PROVIDER=anthropic
# DEFAULT_BOT_MODEL=claude-sonnet-4-6

# ---- connectors, X research, voice ----
COMPOSIO_API_KEY=
XAI_API_KEY=                      # x_search (research on X) and the voice modes
XAI_MODEL=grok-4.7
# https://us.api.x.ai/v1 keeps xAI inference in the US at 1.1x token prices (grok-4.7 and grok-4.6 only).
# Managed bots inherit it, so their Hermes model calls use the same region.
# XAI_BASE_URL=https://api.x.ai/v1
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0

# ---- GPU voice (audio.cpp: OWSM ASR, LFM3-Audio TTS, SoulX-FlashHead avatar) — docs/voice-audiocpp.md ----
# Where audiocpp_server answers. Default: one running natively on this host. In the source compose
# stack the sidecar is http://audiocpp:8080 (docker compose --profile gpu).
# AUDIOCPP_URL=http://127.0.0.1:8080
# Uploaded bot portraits (512x512 JPEG). Default: data/audiocpp-portraits next to the database.
# AUDIOCPP_PORTRAITS_DIR=
# Model ids in the audio.cpp server config, if yours differ from infra/audiocpp/server-config.json.
# AUDIOCPP_ASR_MODEL=chat-recognition
# AUDIOCPP_TTS_MODEL=chat-voice
# AUDIOCPP_AVATAR_MODEL=chat-avatar

