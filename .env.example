# Copy to .env and fill in. Never commit .env.

# ---- the app ----
PORT=8787
APP_URL=http://localhost:5173     # where the web app is served (redirect target after sign-in)
SERVER_URL=http://localhost:8787  # public URL of this server (OAuth callbacks)
SESSION_SECRET=change-me-to-a-long-random-string   # also signs the tokens the agents use to reach /mcp
DEV_LOGIN=1                       # 1 enables POST /api/auth/dev (local testing only)
ALLOWED_EMAILS=                   # comma-separated emails allowed to sign in; empty = anyone who can reach the app
# DB_PATH=./data/grokbot.db       # where the app keeps its SQLite database

# ---- the agents (Hermes) ----
HERMES_BIN=hermes                 # the hermes CLI; it starts one gateway per extra bot
HERMES_URL=http://127.0.0.1:8642  # API server of the agent that already runs (the first bot)
# HERMES_HOME_PRIMARY=~/.hermes   # that agent's home (memory files, .env with API_SERVER_KEY)
# HERMES_KEY=                     # its API key, when not readable from <home>/.env
# ENGINES_DIR=./data/engines      # homes of the extra bots; must be outside ~/.hermes
# ENGINE_PORT_BASE=8650
# MCP_BASE_URL=http://127.0.0.1:8787   # how the agents reach this server
# EXTRA_MCP_SERVERS=              # JSON object of Hermes mcp_servers entries every extra bot gets
# PRIMARY_BOT_NAME=Doug
# PRIMARY_BOT_LABEL=Chief of Staff

# ---- the one computer every bot works on (one Orgo screen per bot) ----
ORGO_API_KEY=                     # or ORGO_API_KEY_FILE=/path/to/file
ORGO_COMPUTER_ID=
HQ_LOCAL=0                        # 1 when this server runs on that computer (production)
# PRIMARY_CDP_URL=http://127.0.0.1:9333   # a Chrome the first bot already owns on the default screen
MAX_BOTS=4                        # Orgo allows four screens on one Linux computer

# ---- a computer of its own for each bot (Docker; see docs/per-bot-computers.md) ----
COMPUTER_KIND=auto                # 'orgo' | 'docker' | 'auto' (auto: docker for every bot but the primary)
COMPUTER_IMAGE=orbit/computer:local   # built from server/docker/computer when unqualified
# COMPUTER_HOME_DIR=./data/computers   # each bot's home folder and workspace checkpoints
# COMPUTER_IDLE_TIMEOUT_MIN=30
# COMPUTER_CPU_LIMIT=2
# COMPUTER_MEMORY_LIMIT=2g
# COMPUTER_NETWORK=bridge
# DOCKER_SOCKET=/var/run/docker.sock   # empty: DOCKER_HOST, else Docker's default
# A new managed Bot inherits the primary agent's model and credentials. These are only the fallback
# when the primary agent has no model configured:
# DEFAULT_BOT_MODEL=deepseek-flash
# DEFAULT_BOT_PROVIDER=deepseek

# ---- connectors, X research, voice ----
COMPOSIO_API_KEY=
XAI_API_KEY=                      # x_search (research on X) and the voice modes
XAI_MODEL=grok-4.7
# XAI_VOICE_MODEL=grok-voice-latest
# XAI_STT_MODEL=grok-voice-transcribe-2.0

# ---- Google OAuth2 (Gmail + Calendar — free, no third-party service) ----
# 1. Go to https://console.cloud.google.com/ → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add Authorised redirect URI: http://localhost:8787/api/google/callback (or your SERVER_URL)
# 4. Enable the Gmail API and Google Calendar API in the Cloud Console
# 5. Paste the client ID and secret below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
