{
  "name": "orbit-workspace",
  "private": true,
  "description": "Orbit: a team of Hermes agents, each with its own screen, with Composio apps and xAI voice.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "pnpm run build:packages && turbo run dev --parallel",
    "build": "turbo run build",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "start": "turbo run start --parallel",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "desktop": "pnpm --filter @orbit/desktop run dev",
    "desktop:pack": "pnpm --filter @orbit/desktop run pack",
    "mobile": "pnpm --filter @orbit/mobile run start",
    "smoke": "node scripts/smoke-server.mjs"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
